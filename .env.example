# Server only. Never prefix these names with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CHECKIN_ACCESS_SECRET=
CHECKIN_APP_ORIGIN=http://localhost:3000
# Admin Auth client (separate from the privileged database client).
SUPABASE_PUBLISHABLE_KEY=
CHECKIN_ADMIN_EMAILS=
# Integration tests only. Must match SUPABASE_URL and must never be the production project.
CHECKIN_TEST_SUPABASE_URL=
# Daily guest sheet sync. Server only; keep disabled until production setup is verified.
CHECKIN_GUEST_SYNC_ENABLED=false
# Shared only with the Apps Script owner's User Properties. At least 32 random bytes.
CHECKIN_GUEST_SYNC_SECRET=
# Optional legacy CLI read credentials; Apps Script does not need these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Use the service account JSON private_key value; literal \n is supported.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# NHN Cloud Alimtalk. Adapter supports approved test recipients only at this stage.
# Never enable on Vercel Preview; no automatic sender is connected yet.
NHN_ALIMTALK_TEST_SEND_ENABLED=false
NHN_ALIMTALK_APP_KEY=
NHN_ALIMTALK_SECRET_KEY=
NHN_ALIMTALK_SENDER_KEY=
# Comma-separated numbers and approved template codes, respectively.
NHN_ALIMTALK_TEST_RECIPIENTS=
NHN_ALIMTALK_APPROVED_TEMPLATE_CODES=

# Durable dispatch defaults to disabled; secrets stay server-side.
CHECKIN_DISPATCH_MODE=disabled
NHN_ALIMTALK_LIVE_SEND_ENABLED=false
CRON_SECRET=

# Explicit prior HTTPS origins accepted during domain migration (comma-separated).
CHECKIN_LEGACY_APP_ORIGINS=
# Optional separate origin for existing administrator authentication callbacks.
CHECKIN_ADMIN_ORIGIN=
